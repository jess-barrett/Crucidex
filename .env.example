# Public site URL — used for Steam OpenID return URL and email confirmation links.
# Local dev: http://localhost:3000   Production: https://www.your-domain.com
NEXT_PUBLIC_SITE_URL=

# Supabase — get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only, NEVER expose to the browser.
# Used for admin operations like cached recommendation writes.
SUPABASE_SERVICE_ROLE_KEY=

# IGDB credentials — register an app at https://dev.twitch.tv/console/apps
# IGDB authenticates via Twitch OAuth.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Steam Web API key — get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
